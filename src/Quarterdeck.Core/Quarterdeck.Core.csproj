<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- NaCl box for the KeePassXC protocol. Native, ISC licence. -->
    <PackageReference Include="libsodium" Version="1.0.22" />
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in agent skills, one copy: docs/skills is what the manual links to. -->
    <EmbeddedResource Include="../../docs/skills/*.md" LogicalName="skills/%(Filename)%(Extension)" />
    <!-- The agent's reader for web pages; it puts this into the page itself. -->
    <EmbeddedResource Include="Agent/weboutline.js" LogicalName="weboutline.js" />
  </ItemGroup>

</Project>
