<UserControl x:Class="Quarterdeck.App.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
  <Grid Background="#10141C">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid x:Name="RecordArea" Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <wv2:WebView2 x:Name="Web" Grid.Column="0" DefaultBackgroundColor="#10141C"/>
      <!-- The agent panel docks here when one is attached to this tab. -->
      <Border x:Name="AgentHost" Grid.Column="1" BorderBrush="#2A3245" BorderThickness="1,0,0,0" Visibility="Collapsed"/>
    </Grid>

    <Border Grid.Row="1" Background="#171C27" Padding="8,3">
      <DockPanel>
        <!-- Shown while a file is being sent, so a long send can be stopped. -->
        <Button x:Name="StatusCancel" DockPanel.Dock="Right" Content="Cancel" Padding="8,0"
                FontSize="11" Visibility="Collapsed" Click="OnStatusCancel"/>
        <!-- Serial and telnet links: connection, TX and RX lamps, filled in by TerminalView.Lamps.cs. -->
        <StackPanel x:Name="LinkLamps" DockPanel.Dock="Right" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="8,0" Visibility="Collapsed"/>
        <TextBlock x:Name="StatusText" Foreground="#8B94A7" FontSize="11" Text="Disconnected."
                   VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
