<Window x:Class="Quarterdeck.App.Views.SecretPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Authentication" Height="210" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#171C27" Foreground="#DFE4EE">
  <StackPanel Margin="16">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#DFE4EE"/>
    <PasswordBox x:Name="SecretBox" Padding="4" FontSize="13"/>
    <CheckBox x:Name="RememberBox" Content="Remember for this shortcut (encrypted on this PC)"
              Margin="0,10,0,0" Foreground="#8B94A7"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="OK" Width="80" IsDefault="True" Click="OnOk"/>
    </StackPanel>
  </StackPanel>
</Window>
