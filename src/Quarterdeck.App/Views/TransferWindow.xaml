<Window x:Class="Quarterdeck.App.Views.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Files" Height="520" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="#171C27" Foreground="#DFE4EE">
  <DockPanel Margin="12">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="Go" Width="60" Margin="6,0,0,0" Click="OnGo"/>
      <Button DockPanel.Dock="Right" Content="Up" Width="60" Margin="6,0,0,0" Click="OnUp"/>
      <TextBox x:Name="PathBox" Text="." Padding="3"/>
    </DockPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <ProgressBar x:Name="Progress" Height="6" Margin="0,0,0,6"/>
      <DockPanel>
        <TextBlock x:Name="StatusText" Foreground="#8B94A7" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <CheckBox x:Name="UseScpBox" Content="Use SCP" Foreground="#8B94A7"
                    VerticalAlignment="Center" Margin="0,0,12,0"
                    ToolTip="For hosts with no SFTP subsystem, such as most network gear."/>
          <Button Content="Download" Width="100" Margin="0,0,8,0" Click="OnDownload"/>
          <Button Content="Upload" Width="100" Click="OnUpload"/>
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
              Background="#10141C" RowBackground="#10141C" Foreground="#DFE4EE"
              GridLinesVisibility="Horizontal" MouseDoubleClick="OnRowActivated">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="Size" Binding="{Binding Length}" Width="110"/>
        <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="170"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
