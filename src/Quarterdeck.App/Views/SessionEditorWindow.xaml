<Window x:Class="Quarterdeck.App.Views.SessionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shortcut properties" Height="620" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="#171C27" Foreground="#DFE4EE">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8B94A7"/>
      <Setter Property="Margin" Value="0,8,0,2"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="3"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#DFE4EE"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TabControl Grid.Row="0" Background="#171C27">
      <TabItem Header="Connection">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Name"/>
            <TextBox x:Name="NameBox"/>
            <TextBlock Text="Folder (use / to nest, blank for top level)"/>
            <TextBox x:Name="FolderBox"/>
            <TextBlock Text="Tags (comma-separated; the filter above the shortcut list matches them)"/>
            <TextBox x:Name="TagsBox"/>
            <TextBlock Text="Protocol"/>
            <ComboBox x:Name="ProtocolBox" SelectionChanged="OnProtocolChanged">
              <ComboBoxItem Content="SSH"/>
              <ComboBoxItem Content="Serial"/>
              <ComboBoxItem Content="Local shell"/>
              <ComboBoxItem Content="Telnet"/>
              <ComboBoxItem Content="VNC"/>
              <ComboBoxItem Content="RTSP camera"/>
            </ComboBox>

            <StackPanel x:Name="SshPanel">
              <TextBlock Text="Host"/>
              <TextBox x:Name="HostBox"/>
              <TextBlock Text="Port"/>
              <TextBox x:Name="PortBox"/>
              <TextBlock Text="Username"/>
              <TextBox x:Name="UserBox"/>
              <TextBlock Text="Authentication"/>
              <ComboBox x:Name="AuthBox" SelectionChanged="OnAuthChanged">
                <ComboBoxItem Content="Password"/>
                <ComboBoxItem Content="Public key file"/>
                <ComboBoxItem Content="SSH agent (KeePassXC, Pageant, OpenSSH agent)"/>
                <ComboBoxItem Content="Keyboard interactive"/>
              </ComboBox>

              <StackPanel x:Name="KeyFilePanel">
                <TextBlock Text="Private key file"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Browse" Width="70" Margin="6,0,0,0" Click="OnBrowseKey"/>
                  <TextBox x:Name="KeyBox"/>
                </DockPanel>
              </StackPanel>

              <StackPanel x:Name="AgentPanel">
                <TextBlock Text="Agent key (optional): part of its comment, or its SHA256 fingerprint. Blank offers every key."/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="List keys" Width="70" Margin="6,0,0,0" Click="OnListAgentKeys"
                          ToolTip="Show the keys the running agents offer"/>
                  <TextBox x:Name="AgentFilterBox"/>
                </DockPanel>
              </StackPanel>

              <StackPanel x:Name="PasswordSourcePanel">
                <TextBlock Text="Password from"/>
                <ComboBox x:Name="PasswordSourceBox" SelectionChanged="OnAuthChanged">
                  <ComboBoxItem Content="Saved here (DPAPI), or ask"/>
                  <ComboBoxItem Content="KeePassXC, looked up at each connect"/>
                </ComboBox>
              </StackPanel>

              <StackPanel x:Name="KeePassPanel">
                <TextBlock Text="KeePassXC entry: blank finds entries with URL ssh://host; or paste the entry's UUID"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Test" Width="70" Margin="6,0,0,0" Click="OnTestKeePass"
                          ToolTip="Look the entry up now (KeePassXC may ask you to allow it); the password is not shown"/>
                  <TextBox x:Name="KeePassEntryBox"/>
                </DockPanel>
              </StackPanel>

              <StackPanel x:Name="SecretPanel">
                <TextBlock x:Name="SecretLabel" Text="Password (stored with DPAPI, blank keeps the existing one)"/>
                <PasswordBox x:Name="SecretBox" Padding="3"/>
              </StackPanel>

              <TextBlock x:Name="AuthNote" TextWrapping="Wrap" Foreground="#8B94A7" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel x:Name="SerialPanel" Visibility="Collapsed">
              <TextBlock Text="Port"/>
              <ComboBox x:Name="SerialPortBox" IsEditable="True" DropDownOpened="OnSerialPortsDropDown"/>
              <TextBlock Text="Baud rate"/>
              <ComboBox x:Name="BaudBox" IsEditable="True"/>
              <TextBlock Text="Data bits"/>
              <ComboBox x:Name="DataBitsBox">
                <ComboBoxItem Content="8"/>
                <ComboBoxItem Content="7"/>
                <ComboBoxItem Content="6"/>
                <ComboBoxItem Content="5"/>
              </ComboBox>
              <TextBlock Text="Parity"/>
              <ComboBox x:Name="ParityBox">
                <ComboBoxItem Content="None"/>
                <ComboBoxItem Content="Even"/>
                <ComboBoxItem Content="Odd"/>
                <ComboBoxItem Content="Mark"/>
                <ComboBoxItem Content="Space"/>
              </ComboBox>
              <TextBlock Text="Stop bits"/>
              <ComboBox x:Name="StopBitsBox">
                <ComboBoxItem Content="One"/>
                <ComboBoxItem Content="OnePointFive"/>
                <ComboBoxItem Content="Two"/>
              </ComboBox>
            </StackPanel>

            <StackPanel x:Name="TelnetPanel" Visibility="Collapsed">
              <TextBlock Text="Host"/>
              <TextBox x:Name="TelnetHostBox"/>
              <TextBlock Text="Port"/>
              <TextBox x:Name="TelnetPortBox"/>
              <CheckBox x:Name="TelnetTlsBox" Content="TLS (telnets): encrypt, and pin the certificate on first use"
                        ToolTip="BaudHound firmware 1.4 and later serve this on port 992. The certificate is self-signed, so you are asked once to trust it, as with an SSH host key."/>
              <CheckBox x:Name="TelnetLineModeBox" Content="Line mode: echo and edit here, send whole lines"
                        ToolTip="For consoles that read whole lines and do not echo what you type, such as BaudHound. Leave it off for routers, switches and anything with its own prompt editing."/>
              <TextBlock Text="A BaudHound serves its UART on port 23, or with TLS on 992, and wants line mode. Most console servers use 23 without line mode."
                         Foreground="#5C6370" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel x:Name="VncPanel" Visibility="Collapsed">
              <TextBlock Text="Host"/>
              <TextBox x:Name="VncHostBox"/>
              <TextBlock Text="Port"/>
              <TextBox x:Name="VncPortBox"/>
              <TextBlock Text="Password (stored with DPAPI, blank keeps the existing one)"/>
              <PasswordBox x:Name="VncSecretBox" Padding="3"/>
              <CheckBox x:Name="VncViewOnlyBox" Content="View only, send no input"/>
              <TextBlock Text="Classic VNC auth is weak by design. Fine on a trusted network, not across one."
                         Foreground="#5C6370" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel x:Name="RtspPanel" Visibility="Collapsed">
              <TextBlock Text="Camera host"/>
              <TextBox x:Name="RtspHostBox"/>
              <TextBlock Text="RTSP port"/>
              <TextBox x:Name="RtspPortBox"/>
              <TextBlock Text="Stream path (blank: ask the camera over ONVIF)"/>
              <TextBox x:Name="RtspPathBox"/>
              <TextBlock Text="Hikvision /Streaming/Channels/101, Dahua /cam/realmonitor?channel=1&amp;subtype=0, Tapo /stream1, Reolink /h264Preview_01_main"
                         Foreground="#5C6370" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock Text="Username"/>
              <TextBox x:Name="RtspUserBox"/>
              <TextBlock Text="Password (stored with DPAPI, blank keeps the existing one)"/>
              <PasswordBox x:Name="RtspSecretBox" Padding="3"/>
              <CheckBox x:Name="RtspTcpBox" Content="RTP over TCP (works through firewalls; UDP is lighter)"/>
              <CheckBox x:Name="RtspLowLatencyBox" Content="Low latency (200 ms buffer instead of 1 s)"/>
              <TextBlock Text="ONVIF port (for pan/tilt/zoom and stream lookup)"/>
              <TextBox x:Name="RtspOnvifPortBox"/>
            </StackPanel>

            <StackPanel x:Name="ShellPanel" Visibility="Collapsed">
              <TextBlock Text="Command line"/>
              <TextBox x:Name="ShellBox"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Terminal">
        <StackPanel Margin="12">
          <TextBlock Text="Theme"/>
          <ComboBox x:Name="ThemeBox">
            <ComboBoxItem Content="Quarterdeck Dark"/>
            <ComboBoxItem Content="Solarized Light"/>
            <ComboBoxItem Content="Campbell"/>
          </ComboBox>
          <TextBlock Text="Font family"/>
          <TextBox x:Name="FontBox"/>
          <TextBlock Text="Font size"/>
          <TextBox x:Name="FontSizeBox"/>
          <TextBlock Text="Scrollback lines"/>
          <TextBox x:Name="ScrollbackBox"/>
          <TextBlock Text="Tab colour (hex or name, blank for none)"/>
          <DockPanel>
            <Rectangle x:Name="ColourSwatch" DockPanel.Dock="Right" Width="26" Height="18"
                       RadiusX="3" RadiusY="3" Margin="6,0,0,0" Stroke="#3A4459"/>
            <TextBox x:Name="TabColorBox" TextChanged="OnTabColorChanged"/>
          </DockPanel>
          <TextBlock Text="#e06c75 red  ·  #98c379 green  ·  #e5c07b amber  ·  #61afef blue"
                     Foreground="#5C6370" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
      </TabItem>

      <TabItem Header="Commands">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                     Text="Shown on the terminal's right-click menu. Tick Confirm for anything that reboots or deletes; tick Enter to run it rather than just type it."/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add" Width="90" Click="OnAddCommand"/>
            <Button Content="Remove" Width="90" Margin="8,0,0,0" Click="OnRemoveCommand"/>
            <Button Content="Restore defaults" Width="130" Margin="8,0,0,0" Click="OnDefaultCommands"/>
          </StackPanel>
          <DataGrid x:Name="CommandGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                    Background="#10141C" RowBackground="#10141C" Foreground="#DFE4EE" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="200"/>
              <DataGridTextColumn Header="Command" Binding="{Binding Text}" Width="*"/>
              <DataGridCheckBoxColumn Header="Enter" Binding="{Binding AppendNewline}" Width="55"/>
              <DataGridCheckBoxColumn Header="Confirm" Binding="{Binding Confirm}" Width="65"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Logging">
        <StackPanel Margin="12">
          <CheckBox x:Name="LogEnabledBox" Content="Log this session to a file"/>
          <TextBlock Text="Directory (blank uses %APPDATA%\BaudHoundTerm\logs)"/>
          <TextBox x:Name="LogDirBox"/>
          <TextBlock Text="File name pattern"/>
          <TextBox x:Name="LogPatternBox"/>
          <CheckBox x:Name="LogStampBox" Content="Prefix each line with a timestamp"/>
          <CheckBox x:Name="LogStripBox" Content="Strip ANSI escape sequences"/>
          <TextBlock Text="Roll at size (MB, 0 disables)"/>
          <TextBox x:Name="LogRollBox"/>
        </StackPanel>
      </TabItem>

      <TabItem Header="Auto-login">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                     Text="Each row waits for text from the far end, then sends a reply. Tick Secret to send the stored password instead of the literal text."/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add step" Width="90" Click="OnAddStep"/>
            <Button Content="Remove" Width="90" Margin="8,0,0,0" Click="OnRemoveStep"/>
          </StackPanel>
          <DataGrid x:Name="LoginGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                    Background="#10141C" RowBackground="#10141C" Foreground="#DFE4EE" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Expect" Binding="{Binding Expect}" Width="*"/>
              <DataGridTextColumn Header="Send" Binding="{Binding Send}" Width="*"/>
              <DataGridCheckBoxColumn Header="Secret" Binding="{Binding IsSecret}" Width="60"/>
              <DataGridCheckBoxColumn Header="Regex" Binding="{Binding IsRegex}" Width="60"/>
              <DataGridTextColumn Header="Timeout ms" Binding="{Binding TimeoutMs}" Width="90"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Highlight">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                     Text="Colour matching output as it arrives. A match split across two reads is missed."/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add rule" Width="90" Click="OnAddHighlight"/>
            <Button Content="Remove" Width="90" Margin="8,0,0,0" Click="OnRemoveHighlight"/>
          </StackPanel>
          <DataGrid x:Name="HighlightGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                    Background="#10141C" RowBackground="#10141C" Foreground="#DFE4EE" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}" Width="*"/>
              <DataGridTextColumn Header="Colour" Binding="{Binding Color}" Width="90"/>
              <DataGridCheckBoxColumn Header="Regex" Binding="{Binding IsRegex}" Width="60"/>
              <DataGridCheckBoxColumn Header="Bold" Binding="{Binding Bold}" Width="55"/>
              <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="45"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Reconnect">
        <StackPanel Margin="12">
          <CheckBox x:Name="ReconnectBox" Content="Reconnect automatically when the connection drops"/>
          <TextBlock Text="Maximum attempts (0 = keep trying)"/>
          <TextBox x:Name="MaxAttemptsBox"/>
          <TextBlock Text="First delay (ms)"/>
          <TextBox x:Name="InitialDelayBox"/>
          <TextBlock Text="Maximum delay (ms)"/>
          <TextBox x:Name="MaxDelayBox"/>
          <TextBlock Text="Backoff factor"/>
          <TextBox x:Name="BackoffBox"/>
        </StackPanel>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Save" Width="90" IsDefault="True" Click="OnSave"/>
    </StackPanel>
  </Grid>
</Window>
