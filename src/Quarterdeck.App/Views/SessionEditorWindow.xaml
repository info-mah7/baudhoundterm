<Window x:Class="Quarterdeck.App.Views.SessionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shortcut properties" Height="620" Width="660"
        WindowStartupLocation="CenterOwner"
        Background="#171C27" Foreground="#DFE4EE">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8B94A7"/>
      <Setter Property="Margin" Value="0,8,0,2"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="3"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#DFE4EE"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Seven pages: a column on the left, not two rows of tabs that swap when clicked. -->
    <TabControl x:Name="EditorTabs" Grid.Row="0" Background="#171C27" TabStripPlacement="Left">
      <TabItem Header="Connection">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Name"/>
            <TextBox x:Name="NameBox"/>
            <TextBlock Text="Folder (use / to nest, blank for top level)"/>
            <TextBox x:Name="FolderBox"/>
            <TextBlock Text="Tags (comma-separated; the filter above the shortcut list matches them)"/>
            <TextBox x:Name="TagsBox"/>
            <CheckBox x:Name="HideAddressBox" Margin="0,8,0,0" Content="Always hide this address and user name (show as dots)"
                      ToolTip="For demos and recordings: the list, tab and status line show ••• instead of the IP, host and user name, even with Hide addresses off. Connecting still uses the real values."/>
            <CheckBox x:Name="AuditBox" Margin="0,8,0,0" Content="Audit: record every session of this shortcut"
                      ToolTip="For supervised access by a third party. The recording starts when the tab connects and runs until the tab closes; it cannot be paused or stopped, and addresses stay visible. Terminals also keep a timestamped session log. At the end the files get a SHA-256 list and are copied to the folder below."/>
            <StackPanel IsEnabled="{Binding IsChecked, ElementName=AuditBox}">
              <TextBlock TextWrapping="Wrap" Text="Copy finished recordings to (a share the person at this PC cannot change, for example \\nas\audit; blank keeps them on this PC only)"/>
              <TextBox x:Name="AuditFolderBox"/>
            </StackPanel>
            <TextBlock Text="Protocol"/>
            <ComboBox x:Name="ProtocolBox" SelectionChanged="OnProtocolChanged">
              <ComboBoxItem Content="SSH"/>
              <ComboBoxItem Content="Serial"/>
              <ComboBoxItem Content="Local shell"/>
              <ComboBoxItem Content="Telnet"/>
              <ComboBoxItem Content="VNC"/>
              <ComboBoxItem Content="RTSP camera"/>
              <ComboBoxItem Content="RDP (Windows Remote Desktop)"/>
              <!-- SQL tabs were removed in build 70. The item stays, hidden, because the list index is
                   the stored protocol number and KVM comes after it. -->
              <ComboBoxItem Content="SQL database (removed)" Visibility="Collapsed" IsEnabled="False"/>
              <ComboBoxItem Content="KVM (agentkvm board)"/>
              <ComboBoxItem Content="Web page (a device's admin page)"/>
            </ComboBox>

            <StackPanel x:Name="SshPanel">
              <TextBlock Text="Host"/>
              <TextBox x:Name="HostBox"/>
              <TextBlock Text="Port"/>
              <TextBox x:Name="PortBox"/>
              <TextBlock Text="Username"/>
              <TextBox x:Name="UserBox"/>
              <TextBlock Text="Authentication"/>
              <ComboBox x:Name="AuthBox" SelectionChanged="OnAuthChanged">
                <ComboBoxItem Content="Password"/>
                <ComboBoxItem Content="Public key file"/>
                <ComboBoxItem Content="SSH agent (KeePassXC, Pageant, OpenSSH agent)"/>
                <ComboBoxItem Content="Keyboard interactive"/>
              </ComboBox>

              <StackPanel x:Name="KeyFilePanel">
                <TextBlock Text="Private key file"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Browse" Width="70" Margin="6,0,0,0" Click="OnBrowseKey"/>
                  <TextBox x:Name="KeyBox"/>
                </DockPanel>
              </StackPanel>

              <StackPanel x:Name="AgentPanel">
                <TextBlock Text="Agent key (optional): part of its comment, or its SHA256 fingerprint. Blank offers every key."/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="List keys" Width="70" Margin="6,0,0,0" Click="OnListAgentKeys"
                          ToolTip="Show the keys the running agents offer"/>
                  <TextBox x:Name="AgentFilterBox"/>
                </DockPanel>
              </StackPanel>

              <StackPanel x:Name="PasswordSourcePanel">
                <TextBlock Text="Password from"/>
                <ComboBox x:Name="PasswordSourceBox" SelectionChanged="OnAuthChanged">
                  <ComboBoxItem Content="Saved on this PC, or ask"/>
                  <ComboBoxItem Content="KeePassXC, looked up at each connect"/>
                </ComboBox>
              </StackPanel>

              <StackPanel x:Name="KeePassPanel">
                <TextBlock Text="KeePassXC entry: blank finds entries with URL ssh://host; or paste the entry's UUID"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Test" Width="70" Margin="6,0,0,0" Click="OnTestKeePass"
                          ToolTip="Look the entry up now (KeePassXC may ask you to allow it); the password is not shown"/>
                  <TextBox x:Name="KeePassEntryBox"/>
                </DockPanel>
              </StackPanel>

              <StackPanel x:Name="SecretPanel">
                <TextBlock x:Name="SecretLabel" Text="Password (encrypted on this PC; blank keeps the existing one)"/>
                <PasswordBox x:Name="SecretBox" Padding="3"/>
              </StackPanel>

              <TextBlock x:Name="AuthNote" TextWrapping="Wrap" Foreground="#8B94A7" Margin="0,6,0,0"/>

              <CheckBox x:Name="TmuxBox" Margin="0,10,0,0"
                        Content="Keep the shell running in tmux when the connection drops"
                        ToolTip="Starts or attaches a tmux session after login; a reconnect attaches to it again. Needs tmux on the host."/>
              <StackPanel IsEnabled="{Binding IsChecked, ElementName=TmuxBox}">
                <TextBlock TextWrapping="Wrap"
                           Text="tmux sessions: each opens in its own tab. Untick Open on connect for one you open only from the shortcut's menu (Open tmux session). Folder and Start command apply when tmux starts the session; while it runs, the tab attaches to it as it is."/>
                <DataGrid x:Name="TmuxGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                          Height="130" Margin="0,4,0,0" HeadersVisibility="Column"
                          Background="#10141C" RowBackground="#10141C" Foreground="#DFE4EE" GridLinesVisibility="Horizontal">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Open on connect" Binding="{Binding OpenOnConnect}" Width="105"/>
                    <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="1.2*"/>
                    <DataGridTextColumn Binding="{Binding Command}" Width="2*">
                      <DataGridTextColumn.Header><TextBlock Text="Start command" ToolTip="What the session runs when tmux creates it, any program: claude --continue || claude, htop, npm run dev. Empty: a shell. Presets fills in common ones."/></DataGridTextColumn.Header>
                    </DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <Button Content="Add" Width="80" Click="OnAddTmuxSession"/>
                  <Button Content="Presets..." Width="80" Margin="8,0,0,0" Click="OnTmuxPresets"
                          ToolTip="Fills in the selected session's start command: Claude Code, Codex, Aider, htop and others. Edit it afterwards as you like."/>
                  <Button Content="Remove" Width="80" Margin="8,0,0,0" Click="OnRemoveTmuxSession"
                          ToolTip="Removes it from the shortcut only: a session already running on the host keeps running"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <StackPanel x:Name="SerialPanel" Visibility="Collapsed">
              <TextBlock Text="Port"/>
              <ComboBox x:Name="SerialPortBox" IsEditable="True" DropDownOpened="OnSerialPortsDropDown"/>
              <TextBlock Text="Baud rate"/>
              <ComboBox x:Name="BaudBox" IsEditable="True"/>
              <TextBlock Text="Data bits"/>
              <ComboBox x:Name="DataBitsBox">
                <ComboBoxItem Content="8"/>
                <ComboBoxItem Content="7"/>
                <ComboBoxItem Content="6"/>
                <ComboBoxItem Content="5"/>
              </ComboBox>
              <TextBlock Text="Parity"/>
              <ComboBox x:Name="ParityBox">
                <ComboBoxItem Content="None"/>
                <ComboBoxItem Content="Even"/>
                <ComboBoxItem Content="Odd"/>
                <ComboBoxItem Content="Mark"/>
                <ComboBoxItem Content="Space"/>
              </ComboBox>
              <TextBlock Text="Stop bits"/>
              <ComboBox x:Name="StopBitsBox">
                <ComboBoxItem Content="One"/>
                <ComboBoxItem Content="OnePointFive"/>
                <ComboBoxItem Content="Two"/>
              </ComboBox>
            </StackPanel>

            <StackPanel x:Name="TelnetPanel" Visibility="Collapsed">
              <TextBlock Text="Host"/>
              <TextBox x:Name="TelnetHostBox"/>
              <TextBlock Text="Port"/>
              <TextBox x:Name="TelnetPortBox"/>
              <CheckBox x:Name="TelnetTlsBox" Content="TLS (telnets): encrypt, and pin the certificate on first use"
                        ToolTip="BaudHound firmware 1.4 and later serve this on port 992. The certificate is self-signed, so you are asked once to trust it, as with an SSH host key."/>
              <CheckBox x:Name="TelnetLineModeBox" Content="Line mode: echo and edit here, send whole lines"
                        ToolTip="For consoles that read whole lines and do not echo what you type, such as BaudHound. Leave it off for routers, switches and anything with its own prompt editing."/>
              <TextBlock Text="A BaudHound serves its UART on port 23, or with TLS on 992, and wants line mode. Most console servers use 23 without line mode."
                         Foreground="#5C6370" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel x:Name="VncPanel" Visibility="Collapsed">
              <TextBlock Text="Host"/>
              <TextBox x:Name="VncHostBox"/>
              <TextBlock Text="Port"/>
              <TextBox x:Name="VncPortBox"/>
              <TextBlock Text="Password (encrypted on this PC; blank keeps the existing one)"/>
              <PasswordBox x:Name="VncSecretBox" Padding="3"/>
              <CheckBox x:Name="VncViewOnlyBox" Content="View only, send no input"/>
              <TextBlock Text="Classic VNC auth is weak by design. Fine on a trusted network, not across one."
                         Foreground="#5C6370" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel x:Name="RdpPanel" Visibility="Collapsed">
              <TextBlock Text="Host"/>
              <TextBox x:Name="RdpHostBox"/>
              <TextBlock Text="Port"/>
              <TextBox x:Name="RdpPortBox"/>
              <TextBlock Text="Username (blank: asked when you connect)"/>
              <TextBox x:Name="RdpUserBox"/>
              <TextBlock Text="Domain (optional)"/>
              <TextBox x:Name="RdpDomainBox"/>
              <TextBlock Text="Password from"/>
              <ComboBox x:Name="RdpPasswordSourceBox">
                <ComboBoxItem Content="Saved on this PC, or ask"/>
                <ComboBoxItem Content="KeePassXC, looked up at each connect"/>
              </ComboBox>
              <TextBlock Text="KeePassXC entry: blank finds entries with URL rdp://host; or paste the entry's UUID"/>
              <TextBox x:Name="RdpKeePassEntryBox"/>
              <TextBlock Text="Password (encrypted on this PC; blank keeps the existing one, none saved means ask)"/>
              <PasswordBox x:Name="RdpSecretBox" Padding="3"/>
              <TextBlock Text="Remote Desktop Gateway (optional)"/>
              <TextBox x:Name="RdpGatewayBox"/>
              <CheckBox x:Name="RdpClipboardBox" Content="Share the clipboard"/>
              <CheckBox x:Name="RdpDrivesBox" Content="Share this PC's drives (the server can read them)"/>
              <CheckBox x:Name="RdpAdminBox" Content="Admin session (like mstsc /admin)"/>
              <TextBlock Text="Uses Windows' own Remote Desktop client. The remote desktop follows the tab's size."
                         Foreground="#5C6370" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel x:Name="KvmPanel" Visibility="Collapsed">
              <TextBlock Text="KVM board address (the board, not the machine it is plugged into)"/>
              <TextBox x:Name="KvmHostBox"/>
              <TextBlock Text="Daemon port (agentkvmd)"/>
              <TextBox x:Name="KvmPortBox"/>
              <CheckBox x:Name="KvmTlsBox" Content="https (needed for anything but a private network)"/>
              <TextBlock Text="Daemon key (encrypted on this PC; blank keeps the existing one, none saved means ask)"/>
              <PasswordBox x:Name="KvmKeyBox" Padding="3"/>
              <TextBlock Text="Picture from (blank: the same board's web interface; a single - for no picture)"/>
              <TextBox x:Name="KvmVideoUrlBox"/>
              <TextBlock Text="Web interface username"/>
              <TextBox x:Name="KvmVideoUserBox"/>
              <TextBlock Text="Web interface password (encrypted on this PC; blank keeps the existing one, none saved means ask)"/>
              <PasswordBox x:Name="KvmVideoSecretBox" Padding="3"/>
              <DockPanel Margin="0,8,0,0">
                <Button x:Name="KvmPairButton" DockPanel.Dock="Left" Content="Pair with portal" Padding="10,3" Click="OnKvmPair"
                        ToolTip="Signs in to the board's web interface with the username and password above and fetches the daemon key for you, so you never copy it by hand."/>
                <TextBlock x:Name="KvmPairStatus" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" Foreground="#8B94A7"/>
              </DockPanel>
              <TextBlock Text="Pairing fills in the daemon key automatically: enter the address and the web interface login above, then Pair. The board types on the target over USB and watches its HDMI output, so nothing is installed on the target and it need not be on the network. The keyboard is a US layout: a target set to another one receives some characters wrong."
                         Foreground="#5C6370" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel x:Name="WebPanel" Visibility="Collapsed">
              <TextBlock Text="Address (https://192.0.2.99, or a host name; the tab stays on this site)"/>
              <TextBox x:Name="WebUrlBox" LostFocus="OnWebUrlChanged"/>
              <CheckBox x:Name="WebAllowChangesBox" Margin="0,8,0,0" Content="The agent may change settings (asking as the endpoint's Approval setting says)"
                        ToolTip="Off: the agent only reads and checks. Anything that would change the device (Apply, Save, OK, Delete, a switch or check box, a form) waits for your yes, whatever the endpoint says."/>
              <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Left" Content="Forget certificate" Padding="10,3" Click="OnWebForgetCert"
                        ToolTip="For a device whose certificate was replaced on purpose: the next visit shows the new one for you to accept."/>
                <TextBlock x:Name="WebCertText" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" Foreground="#8B94A7"/>
              </DockPanel>
              <TextBlock Text="Log in on the page yourself: the agent never types passwords. The tab keeps its own cookies for this shortcut. Other sites, new windows and downloads do not open in it."
                         Foreground="#5C6370" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel x:Name="RtspPanel" Visibility="Collapsed">
              <TextBlock Text="Camera host"/>
              <TextBox x:Name="RtspHostBox"/>
              <TextBlock Text="RTSP port"/>
              <TextBox x:Name="RtspPortBox"/>
              <TextBlock Text="Stream path (blank: ask the camera over ONVIF)"/>
              <TextBox x:Name="RtspPathBox"/>
              <TextBlock Text="Hikvision /Streaming/Channels/101, Dahua /cam/realmonitor?channel=1&amp;subtype=0, Tapo /stream1, Reolink /h264Preview_01_main"
                         Foreground="#5C6370" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock Text="Username"/>
              <TextBox x:Name="RtspUserBox"/>
              <TextBlock Text="Password (encrypted on this PC; blank keeps the existing one)"/>
              <PasswordBox x:Name="RtspSecretBox" Padding="3"/>
              <CheckBox x:Name="RtspTcpBox" Content="RTP over TCP (works through firewalls; UDP is lighter)"/>
              <CheckBox x:Name="RtspLowLatencyBox" Content="Low latency (200 ms buffer instead of 1 s)"/>
              <TextBlock Text="ONVIF port (for pan/tilt/zoom and stream lookup)"/>
              <TextBox x:Name="RtspOnvifPortBox"/>
            </StackPanel>

            <StackPanel x:Name="ShellPanel" Visibility="Collapsed">
              <TextBlock Text="Command line"/>
              <TextBox x:Name="ShellBox"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Appearance" x:Name="AppearanceTab">
        <StackPanel Margin="12">
          <StackPanel x:Name="TerminalAppearancePanel">
            <TextBlock Text="Theme"/>
            <ComboBox x:Name="ThemeBox">
              <ComboBoxItem Content="BaudHoundTerm Dark"/>
              <ComboBoxItem Content="Solarized Light"/>
              <ComboBoxItem Content="Campbell"/>
            </ComboBox>
            <TextBlock Text="Font family"/>
            <TextBox x:Name="FontBox"/>
            <TextBlock Text="Font size"/>
            <TextBox x:Name="FontSizeBox"/>
            <TextBlock Text="Scrollback lines"/>
            <TextBox x:Name="ScrollbackBox"/>
            <CheckBox x:Name="WheelArrowsBox" Margin="0,10,0,0"
                      Content="Mouse wheel sends Up/Down in full-screen programs"
                      ToolTip="In vim, less or tmux (when they do not use the mouse) the wheel moves by sending arrow keys, as other terminals do. Untick it if the wheel steps through command history instead of scrolling."/>
            <CheckBox x:Name="RemoteClipboardBox" Margin="0,6,0,0"
                      Content="Programs may copy to this PC's clipboard (SSH and local shells)"
                      ToolTip="tmux, vim and Claude Code can put what you select or copy there onto the Windows clipboard (OSC 52). They can only write to it, never read it. The status line says each time it happens."/>
          </StackPanel>
          <TextBlock Text="Tab colour (hex or name, blank for none)"/>
          <DockPanel>
            <Rectangle x:Name="ColourSwatch" DockPanel.Dock="Right" Width="26" Height="18"
                       RadiusX="3" RadiusY="3" Margin="6,0,0,0" Stroke="#3A4459"/>
            <TextBox x:Name="TabColorBox" TextChanged="OnTabColorChanged"/>
          </DockPanel>
          <TextBlock Text="#e06c75 red  ·  #98c379 green  ·  #e5c07b amber  ·  #61afef blue"
                     Foreground="#5C6370" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
      </TabItem>

      <TabItem Header="Commands" x:Name="CommandsTab">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                     Text="Shown on the terminal's right-click menu. Tick Confirm for anything that reboots or deletes; tick Enter to run it rather than just type it."/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add" Width="80" Click="OnAddCommand"/>
            <Button Content="Remove" Width="80" Margin="8,0,0,0" Click="OnRemoveCommand"/>
            <Button Content="Move up" Width="80" Margin="8,0,0,0" Click="OnMoveCommandUp"
                    ToolTip="Earlier on the right-click menu (Ctrl+Up). You can also drag a row by its left edge."/>
            <Button Content="Move down" Width="86" Margin="8,0,0,0" Click="OnMoveCommandDown"
                    ToolTip="Later on the right-click menu (Ctrl+Down)"/>
            <Button Content="Restore defaults" Width="120" Margin="8,0,0,0" Click="OnDefaultCommands"/>
          </StackPanel>
          <DataGrid x:Name="CommandGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                    Background="#10141C" RowBackground="#10141C" Foreground="#DFE4EE" GridLinesVisibility="Horizontal"
                    AllowDrop="True" PreviewKeyDown="OnCommandGridKey"
                    PreviewMouseLeftButtonDown="OnCommandDragStart" PreviewMouseMove="OnCommandDragMove"
                    DragOver="OnCommandDragOver" Drop="OnCommandDrop">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="200"/>
              <DataGridTextColumn Header="Command" Binding="{Binding Text}" Width="*"/>
              <DataGridCheckBoxColumn Header="Enter" Binding="{Binding AppendNewline}" Width="55"/>
              <DataGridCheckBoxColumn Header="Confirm" Binding="{Binding Confirm}" Width="65"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Logging" x:Name="LoggingTab">
        <StackPanel Margin="12">
          <CheckBox x:Name="LogEnabledBox" Content="Log this session to a file"/>
          <TextBlock Text="Directory (blank uses %APPDATA%\BaudHoundTerm\logs)"/>
          <TextBox x:Name="LogDirBox"/>
          <TextBlock Text="File name pattern"/>
          <TextBox x:Name="LogPatternBox"/>
          <CheckBox x:Name="LogStampBox" Content="Prefix each line with a timestamp"/>
          <CheckBox x:Name="LogStripBox" Content="Strip ANSI escape sequences"/>
          <TextBlock Text="Roll at size (MB, 0 disables)"/>
          <TextBox x:Name="LogRollBox"/>
        </StackPanel>
      </TabItem>

      <TabItem Header="Auto-login" x:Name="AutoLoginTab">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                     Text="Each row waits for text from the far end, then sends a reply. Tick Secret to send the stored password instead of the literal text."/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add step" Width="90" Click="OnAddStep"/>
            <Button Content="Remove" Width="90" Margin="8,0,0,0" Click="OnRemoveStep"/>
          </StackPanel>
          <DataGrid x:Name="LoginGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                    Background="#10141C" RowBackground="#10141C" Foreground="#DFE4EE" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Expect" Binding="{Binding Expect}" Width="*"/>
              <DataGridTextColumn Header="Send" Binding="{Binding Send}" Width="*"/>
              <DataGridCheckBoxColumn Header="Secret" Binding="{Binding IsSecret}" Width="60"/>
              <DataGridCheckBoxColumn Header="Regex" Binding="{Binding IsRegex}" Width="60"/>
              <DataGridTextColumn Header="Timeout ms" Binding="{Binding TimeoutMs}" Width="90"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Highlight" x:Name="HighlightTab">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                     Text="Colour matching output as it arrives. A match split across two reads is missed."/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add rule" Width="90" Click="OnAddHighlight"/>
            <Button Content="Remove" Width="90" Margin="8,0,0,0" Click="OnRemoveHighlight"/>
          </StackPanel>
          <DataGrid x:Name="HighlightGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                    Background="#10141C" RowBackground="#10141C" Foreground="#DFE4EE" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}" Width="*"/>
              <DataGridTextColumn Header="Colour" Binding="{Binding Color}" Width="90"/>
              <DataGridCheckBoxColumn Header="Regex" Binding="{Binding IsRegex}" Width="60"/>
              <DataGridCheckBoxColumn Header="Bold" Binding="{Binding Bold}" Width="55"/>
              <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="45"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Reconnect" x:Name="ReconnectTab">
        <StackPanel Margin="12">
          <CheckBox x:Name="ReconnectBox" Content="Reconnect automatically when the connection drops"/>
          <TextBlock Text="Maximum attempts (0 = keep trying)"/>
          <TextBox x:Name="MaxAttemptsBox"/>
          <TextBlock Text="First delay (ms)"/>
          <TextBox x:Name="InitialDelayBox"/>
          <TextBlock Text="Maximum delay (ms)"/>
          <TextBox x:Name="MaxDelayBox"/>
          <TextBlock Text="Backoff factor"/>
          <TextBox x:Name="BackoffBox"/>
        </StackPanel>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Save" Width="90" IsDefault="True" Click="OnSave" Style="{StaticResource QdPrimary}"/>
    </StackPanel>
  </Grid>
</Window>
