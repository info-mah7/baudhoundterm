<Window x:Class="Quarterdeck.App.Views.CredentialPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect" Height="260" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#171C27" Foreground="#DFE4EE">
  <StackPanel Margin="16">
    <TextBlock x:Name="TargetText" Foreground="#8B94A7" Margin="0,0,0,10"/>

    <TextBlock Text="Username" Foreground="#8B94A7" Margin="0,0,0,2"/>
    <TextBox x:Name="UserBox" Padding="4"/>

    <TextBlock Text="Password" Foreground="#8B94A7" Margin="0,10,0,2"/>
    <PasswordBox x:Name="SecretBox" Padding="4"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Connect" Width="90" IsDefault="True" Click="OnOk"/>
    </StackPanel>
  </StackPanel>
</Window>
