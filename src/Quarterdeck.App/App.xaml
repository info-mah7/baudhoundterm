<Application x:Class="Quarterdeck.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pc="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- WPF menus, tabs and combo boxes take their colours from SystemColors, not from the
         parent's Foreground. Left alone they draw black text on this dark chrome. Both the
         brushes and the styles are needed: the brushes cover the popup surfaces the templates
         paint themselves, the styles cover the items. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#1C2230"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#171C27"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#DFE4EE"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#2F3B52"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1C2230"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#DFE4EE"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#10141C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#DFE4EE"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2F3B52"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#7C8AA0"/>

    <!-- Keyboard focus. The stock focus rectangle is black dots, invisible on this chrome, and
         the templated controls below would otherwise show none at all. -->
    <Style x:Key="QdFocusVisual">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-2" Stroke="#7AA2F7" StrokeThickness="2" RadiusX="3" RadiusY="3"
                       SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" BasedOn="{StaticResource QdFocusVisual}"/>

    <Style TargetType="Menu">
      <Setter Property="Background" Value="#171C27"/>
      <Setter Property="Foreground" Value="#DFE4EE"/>
    </Style>
    <!-- Menu popups ignore SystemColors overrides in the Windows theme: the templates paint
         their own light surface. These four templates are the only way to get a dark menu. -->
    <ControlTemplate x:Key="QdTopLevelItem" TargetType="MenuItem">
      <Border x:Name="Box" Background="Transparent" Padding="9,4">
        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter TargetName="Box" Property="Background" Value="#2F3B52"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="#5C6370"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="QdTopLevelHeader" TargetType="MenuItem">
      <Border x:Name="Box" Background="Transparent" Padding="9,4">
        <Grid>
          <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
          <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                 IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom"
                 PopupAnimation="None" HorizontalOffset="-2">
            <Border Background="#1C2230" BorderBrush="#3A4459" BorderThickness="1" Padding="0,3"
                    SnapsToDevicePixels="True">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </Popup>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter TargetName="Box" Property="Background" Value="#2F3B52"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="QdSubmenuItem" TargetType="MenuItem">
      <Border x:Name="Box" Background="Transparent" Padding="0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <!-- The Icon slot carries the colour swatches on the tab menu. -->
          <ContentPresenter Grid.Column="0" ContentSource="Icon" Margin="6,0,0,0"
                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                            Margin="4,5,12,5" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#7C8AA0"
                     Margin="0,5,16,5" VerticalAlignment="Center" FontSize="11"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter TargetName="Box" Property="Background" Value="#2F3B52"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="#5C6370"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="QdSubmenuHeader" TargetType="MenuItem">
      <Border x:Name="Box" Background="Transparent">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ContentPresenter Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True"
                            Margin="16,5,12,5" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="&#9654;" Foreground="#7C8AA0" Margin="0,5,10,5"
                     VerticalAlignment="Center" FontSize="9"/>
          <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                 IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" PopupAnimation="None">
            <Border Background="#1C2230" BorderBrush="#3A4459" BorderThickness="1" Padding="0,3">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </Popup>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter TargetName="Box" Property="Background" Value="#2F3B52"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#DFE4EE"/>
      <Style.Triggers>
        <Trigger Property="Role" Value="TopLevelItem">
          <Setter Property="Template" Value="{StaticResource QdTopLevelItem}"/>
        </Trigger>
        <Trigger Property="Role" Value="TopLevelHeader">
          <Setter Property="Template" Value="{StaticResource QdTopLevelHeader}"/>
        </Trigger>
        <Trigger Property="Role" Value="SubmenuItem">
          <Setter Property="Template" Value="{StaticResource QdSubmenuItem}"/>
        </Trigger>
        <Trigger Property="Role" Value="SubmenuHeader">
          <Setter Property="Template" Value="{StaticResource QdSubmenuHeader}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="#1C2230"/>
      <Setter Property="Foreground" Value="#DFE4EE"/>
      <Setter Property="BorderBrush" Value="#3A4459"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="#1C2230" BorderBrush="#3A4459" BorderThickness="1" Padding="0,3">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Separator">
      <Setter Property="Background" Value="#3A4459"/>
    </Style>
    <!-- Menus look up their separators by this key, not by the implicit Separator style,
         and the stock one draws a white line. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Margin="0,4" Background="#3A4459"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Text boxes otherwise show WPF's built-in edit menu, an internal ContextMenu subclass
         that implicit styles never reach, so it stays light. Ours is driven from App.xaml.cs
         rather than by routed commands, which asked the wrong element whether they could run. -->
    <ContextMenu x:Key="QdEditMenu" x:Shared="False" Opened="OnEditMenuOpened">
      <MenuItem Header="Cu_t" Tag="cut" InputGestureText="Ctrl+X" Click="OnEditMenuClick"/>
      <MenuItem Header="_Copy" Tag="copy" InputGestureText="Ctrl+C" Click="OnEditMenuClick"/>
      <MenuItem Header="_Paste" Tag="paste" InputGestureText="Ctrl+V" Click="OnEditMenuClick"/>
      <Separator/>
      <MenuItem Header="Select _all" Tag="all" InputGestureText="Ctrl+A" Click="OnEditMenuClick"/>
    </ContextMenu>
    <!-- The stock ComboBox paints its own light surface from theme brushes, so a dark
         Foreground setter alone leaves pale text on white. Template it. -->
    <Style TargetType="ComboBox">
      <Setter Property="FocusVisualStyle" Value="{StaticResource QdFocusVisual}"/>
      <Setter Property="Foreground" Value="#DFE4EE"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton ClickMode="Press" Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Box" Background="#10141C" BorderBrush="#5D6984"
                            BorderThickness="1" CornerRadius="2">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                            Data="M0,0 L8,0 L4,5 Z" Fill="#8B94A7"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Box" Property="BorderBrush" Value="#8B94A7"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <ContentPresenter x:Name="Selected" Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="8,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False"/>

              <!-- An editable ComboBox needs a part with this exact name or it renders empty
                   and swallows typing. The margin leaves the arrow clickable underneath. -->
              <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed"
                       Margin="4,1,22,1" Padding="3,0" VerticalContentAlignment="Center"
                       Background="Transparent" Foreground="#DFE4EE" BorderThickness="0"
                       CaretBrush="#DFE4EE" SelectionBrush="#2F3B52"/>

              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                <Border Background="#1C2230" BorderBrush="#3A4459" BorderThickness="1" Padding="0,2"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <!-- Without a ScrollViewer a long list (80 models) runs off the screen. -->
                  <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>

            <ControlTemplate.Triggers>
              <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Selected" Property="Visibility" Value="Collapsed"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#DFE4EE"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Box" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#2F3B52"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- The stock tab paints a light selected header from the Windows theme, which left the
         active tab white on white. Template it so selection reads as a lit tab on dark chrome. -->
    <Style TargetType="TabItem">
      <Setter Property="FocusVisualStyle" Value="{StaticResource QdFocusVisual}"/>
      <Setter Property="Foreground" Value="#8B94A7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Box" Background="#141922" BorderBrush="#232A38"
                    BorderThickness="1,1,1,0" CornerRadius="3,3,0,0"
                    Margin="0,2,2,0" Padding="11,5">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#0F131A"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#3A4459"/>
                <Setter TargetName="Box" Property="Margin" Value="0,0,2,0"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Panel.ZIndex" Value="1"/>
              </Trigger>
              <!-- A strip on the left (the shortcut editor) reads as a list of pages. -->
              <Trigger Property="TabStripPlacement" Value="Left">
                <Setter TargetName="Box" Property="BorderThickness" Value="1,1,0,1"/>
                <Setter TargetName="Box" Property="CornerRadius" Value="3,0,0,3"/>
                <Setter TargetName="Box" Property="Margin" Value="0,0,0,2"/>
                <Setter TargetName="Box" Property="Padding" Value="12,7"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="False"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Box" Property="Background" Value="#1C2230"/>
                <Setter Property="Foreground" Value="#DFE4EE"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#DFE4EE"/>
    </Style>
    <!-- The stock ListBox paints a white surface from the Windows theme. -->
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#10141C"/>
      <Setter Property="Foreground" Value="#DFE4EE"/>
      <Setter Property="BorderBrush" Value="#5D6984"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource QdFocusVisual}"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#DFE4EE"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource QdFocusVisual}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Box" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#1C2230"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#2F3B52"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="#DFE4EE"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{StaticResource QdFocusVisual}"/>
      <Setter Property="Foreground" Value="#DFE4EE"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#10141C"/>
      <Setter Property="Foreground" Value="#DFE4EE"/>
      <Setter Property="RowBackground" Value="#10141C"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#232A38"/>
      <Setter Property="VerticalGridLinesBrush" Value="#232A38"/>
    </Style>
    <Style TargetType="pc:DataGridColumnHeader">
      <Setter Property="Background" Value="#1C2230"/>
      <Setter Property="Foreground" Value="#DFE4EE"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="TabControl">
      <!-- The tabs are the stops; the control itself is not one. -->
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Background" Value="#0F131A"/>
      <Setter Property="BorderBrush" Value="#232A38"/>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="#DFE4EE"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="#1C2230" BorderBrush="#3A4459" BorderThickness="1" Padding="8,4"
                    MaxWidth="460">
              <ContentPresenter>
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Templated: the stock button turns pale blue on hover and press. -->
    <Style TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource QdFocusVisual}"/>
      <Setter Property="Background" Value="#2A3245"/>
      <Setter Property="Foreground" Value="#DFE4EE"/>
      <Setter Property="BorderBrush" Value="#3A4459"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
              <Border x:Name="Shade" Background="Transparent" CornerRadius="2"/>
              <!-- The empty TextBlock style blocks the app-wide one, which pinned every label
                   to one colour: disabled buttons looked exactly like enabled ones. -->
              <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock"/>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shade" Property="Background" Value="#33FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Shade" Property="Background" Value="#33000000"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#5C6370"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- The most likely action in a dialog: Save, Connect to device. -->
    <Style x:Key="QdPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#3B5BA9"/>
      <Setter Property="BorderBrush" Value="#7AA2F7"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Style.Triggers>
        <!-- Disabled, it is an ordinary dimmed button: grey text on the accent read as broken. -->
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#2A3245"/>
          <Setter Property="BorderBrush" Value="#3A4459"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#10141C"/>
      <Setter Property="ContextMenu" Value="{StaticResource QdEditMenu}"/>
      <Setter Property="Foreground" Value="#DFE4EE"/>
      <Setter Property="BorderBrush" Value="#5D6984"/>
      <Setter Property="CaretBrush" Value="#DFE4EE"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#10141C"/>
      <Setter Property="ContextMenu" Value="{StaticResource QdEditMenu}"/>
      <Setter Property="Foreground" Value="#DFE4EE"/>
      <Setter Property="BorderBrush" Value="#5D6984"/>
      <Setter Property="CaretBrush" Value="#DFE4EE"/>
    </Style>
  </Application.Resources>
</Application>
