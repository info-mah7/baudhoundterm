<Window x:Class="Quarterdeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BaudHoundTerm" Height="760" Width="1200"
        Background="#0F131A" Foreground="#DFE4EE">
  <Window.InputBindings>
    <KeyBinding Key="T" Modifiers="Ctrl+Shift" Command="{x:Static ApplicationCommands.New}"/>
    <KeyBinding Key="F" Modifiers="Ctrl+Shift" Command="{x:Static ApplicationCommands.Find}"/>
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static ApplicationCommands.New}" Executed="OnNewSession"/>
    <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="OnFind"/>
  </Window.CommandBindings>

  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="#171C27" Foreground="#DFE4EE">
      <MenuItem Header="_Session">
        <MenuItem Header="_New..." Click="OnNewSession" InputGestureText="Ctrl+Shift+T"/>
        <MenuItem Header="New _folder..." Click="OnNewFolder"/>
        <MenuItem Header="_Move to folder..." Click="OnMoveToFolder"/>
        <MenuItem Header="_Connect" Click="OnConnect"/>
        <MenuItem Header="_Clone" Click="OnClone"/>
        <MenuItem Header="_Properties..." Click="OnEdit"/>
        <MenuItem Header="_Delete" Click="OnDelete"/>
        <Rectangle/>
        <MenuItem Header="E_xit" Click="OnExit"/>
      </MenuItem>
      <MenuItem Header="_Terminal">
        <MenuItem Header="_Find in scrollback" Click="OnFind" InputGestureText="Ctrl+Shift+F"/>
        <MenuItem Header="C_lear screen" Click="OnClear"/>
        <MenuItem Header="_Disconnect tab" Click="OnDisconnectTab"/>
        <MenuItem Header="Close ta_b" Click="OnCloseTab"/>
      </MenuItem>
      <MenuItem Header="_Transfer">
        <MenuItem Header="Open _file transfer..." Click="OnTransfer"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Open log folder" Click="OnOpenLogs"/>
        <MenuItem Header="_About" Click="OnAbout"/>
      </MenuItem>
    </Menu>

    <!-- A WrapPanel, not a ToolBar: WPF's ToolBar pushes items it thinks do not fit into an
         overflow chevron and clips their labels ("Clos", "Clea"). This wraps to a second row
         instead, so every command stays readable at any window width. -->
    <Border DockPanel.Dock="Top" Background="#141922" BorderBrush="#0F131A" BorderThickness="0,0,0,1" Padding="4,3">
      <WrapPanel Orientation="Horizontal">
        <WrapPanel.Resources>
          <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DFE4EE"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="1,1"/>
            <Setter Property="MinWidth" Value="64"/>
          </Style>
          <Style TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Fill" Value="#3A4459"/>
          </Style>
        </WrapPanel.Resources>

        <Button Click="OnNewSession" ToolTip="New session (Ctrl+Shift+T)">New</Button>
        <Button Click="OnEdit" ToolTip="Open the selected session's properties">Open</Button>
        <Button Click="OnClone" ToolTip="Clone the selected session, keeping its stored secret">Clone</Button>
        <Rectangle/>
        <Button Click="OnConnect" ToolTip="Connect the selected session in a new tab">Connect</Button>
        <Button Click="OnDisconnectTab" ToolTip="Disconnect the active tab, leaving it open">Disconnect</Button>
        <Button Click="OnCloseTab" ToolTip="Disconnect and close the active tab">Close</Button>
        <Rectangle/>
        <Button Click="OnQuickLocalShell" ToolTip="Local shell in a new tab, without saving a session">Local</Button>
        <Button Click="OnAdminShell" ToolTip="Elevated shell. Relaunches BaudHoundTerm through UAC when it is not already elevated.">Admin</Button>
        <Rectangle/>
        <Button Click="OnTransfer" ToolTip="SFTP/SCP file transfer for the active SSH session">Transfer</Button>
        <Button Click="OnFind" ToolTip="Find in scrollback (Ctrl+Shift+F)">Find</Button>
        <Button Click="OnClear" ToolTip="Clear the screen">Clear</Button>
        <Rectangle/>
        <Button Click="OnBaudHound" ToolTip="Connect to a BaudHound wireless serial console over telnet">BaudHound</Button>
      </WrapPanel>
    </Border>

    <!-- Quick connect: no saved session, just somewhere to go. -->
    <Border DockPanel.Dock="Top" Background="#141922" BorderBrush="#0F131A" BorderThickness="0,0,0,1" Padding="5,4">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Left" Text="Quick connect" Foreground="#8B94A7"
                   VerticalAlignment="Center" Margin="4,0,8,0"/>
        <ComboBox x:Name="QuickProtocol" DockPanel.Dock="Left" Width="110" SelectedIndex="0"
                  VerticalAlignment="Center" ToolTip="Protocol"
                  SelectionChanged="OnQuickProtocolChanged">
          <ComboBoxItem Content="SSH"/>
          <ComboBoxItem Content="Serial"/>
          <ComboBoxItem Content="Local shell"/>
          <ComboBoxItem Content="Telnet"/>
        </ComboBox>
        <Button DockPanel.Dock="Right" Content="Connect" Width="90" Margin="8,0,2,0"
                Click="OnQuickConnect" IsDefault="True"/>

        <!-- Serial asks for a port and a speed rather than a syntax to memorise. -->
        <StackPanel x:Name="QuickSerialPanel" DockPanel.Dock="Left" Orientation="Horizontal"
                    Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,0,0">
          <TextBlock Text="Port" Foreground="#8B94A7" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox x:Name="QuickSerialPort" Width="110" IsEditable="True"
                    DropDownOpened="OnSerialPortsDropDown"
                    ToolTip="COM port. The list refreshes each time it is opened."/>
          <TextBlock Text="Baud" Foreground="#8B94A7" VerticalAlignment="Center" Margin="12,0,6,0"/>
          <ComboBox x:Name="QuickBaud" Width="90" IsEditable="True" Text="115200"/>
          <TextBlock Text="Framing" Foreground="#8B94A7" VerticalAlignment="Center" Margin="12,0,6,0"/>
          <ComboBox x:Name="QuickFraming" Width="80" SelectedIndex="0"
                    ToolTip="Data bits, parity, stop bits">
            <ComboBoxItem Content="8-N-1"/>
            <ComboBoxItem Content="7-E-1"/>
            <ComboBoxItem Content="7-O-1"/>
            <ComboBoxItem Content="8-N-2"/>
          </ComboBox>
        </StackPanel>

        <TextBox x:Name="QuickAddress" Margin="8,0,0,0" Padding="4,3" VerticalAlignment="Center"
                 KeyDown="OnQuickAddressKey"
                 ToolTip="SSH or Telnet: host, or host:port. Serial: COM3@115200. Local shell: a command line. The SSH username is asked when you connect."/>
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" MinWidth="180"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0" Background="#141922">
        <DockPanel DockPanel.Dock="Top" Margin="6">
          <Button DockPanel.Dock="Right" Content="+" Width="26" Margin="6,0,0,0"
                  ToolTip="New session" Click="OnNewSession"/>
          <TextBox x:Name="FilterBox" Padding="3" TextChanged="OnFilterChanged"
                   ToolTip="Filter sessions by name, host or tag"/>
        </DockPanel>

        <TreeView x:Name="SessionTree" Background="#141922" Foreground="#DFE4EE"
                  BorderThickness="0" MouseDoubleClick="OnTreeActivated"
                  PreviewMouseRightButtonDown="OnTreeRightClick">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <Setter Property="IsExpanded" Value="True"/>
              <!-- Without an explicit Foreground the item falls back to the system colour,
                   which is black: invisible on this background. The Style.Resources override
                   the selection brushes for the same reason - the default selected text is
                   black on pale blue. -->
              <Setter Property="Foreground" Value="#DFE4EE"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Padding" Value="2,1"/>
              <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2F3B52"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#232A38"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#DFE4EE"/>
              </Style.Resources>
            </Style>
          </TreeView.ItemContainerStyle>

          <TreeView.ContextMenu>
            <ContextMenu Background="#1C2230" Foreground="#DFE4EE">
              <MenuItem Header="_Connect" Click="OnConnect"/>
              <Separator/>
              <MenuItem Header="_Properties..." Click="OnEdit"/>
              <MenuItem Header="C_lone" Click="OnClone"/>
              <MenuItem Header="_Move to folder..." Click="OnMoveToFolder"/>
              <MenuItem Header="_Delete" Click="OnDelete"/>
              <Separator/>
              <MenuItem Header="New _folder..." Click="OnNewFolder"/>
              <MenuItem Header="Rename folder..." Click="OnRenameFolder"/>
              <MenuItem Header="Delete folder..." Click="OnDeleteFolder"/>
            </ContextMenu>
          </TreeView.ContextMenu>
        </TreeView>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#0F131A"/>

      <!-- The TabControl's own Background does not paint the content panel, which left a
           white slab before the first tab existed. The Border behind it does. -->
      <Border Grid.Column="2" Background="#0F131A">
        <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0"/>
      </Border>
    </Grid>
  </DockPanel>
</Window>
