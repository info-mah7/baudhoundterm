<Window x:Class="Quarterdeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BaudHoundTerm" Height="760" Width="1200" Icon="/baudhoundterm.ico"
        Background="#0F131A" Foreground="#DFE4EE">
  <Window.InputBindings>
    <KeyBinding Key="T" Modifiers="Ctrl+Shift" Command="{x:Static ApplicationCommands.New}"/>
    <KeyBinding Key="F" Modifiers="Ctrl+Shift" Command="{x:Static ApplicationCommands.Find}"/>
    <KeyBinding Key="A" Modifiers="Ctrl+Shift" Command="{x:Static ApplicationCommands.Properties}"/>
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static ApplicationCommands.New}" Executed="OnNewSession"/>
    <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="OnFind"/>
    <!-- Ctrl+Shift+A: attach or detach the agent on the active tab. -->
    <CommandBinding Command="{x:Static ApplicationCommands.Properties}" Executed="OnToggleAgent"/>
  </Window.CommandBindings>

  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="#171C27" Foreground="#DFE4EE">
      <MenuItem Header="_Shortcut">
        <MenuItem Header="_New shortcut..." Click="OnNewSession" InputGestureText="Ctrl+Shift+T"/>
        <MenuItem Header="New _folder..." Click="OnNewFolder"/>
        <MenuItem Header="_Move to folder..." Click="OnMoveToFolder"/>
        <MenuItem x:Name="ConnectMenu" Header="_Connect" Click="OnConnect"/>
        <MenuItem x:Name="PropertiesMenu" Header="_Properties..." Click="OnEdit"/>
        <MenuItem x:Name="DeleteMenu" Header="_Delete shortcut" Click="OnDelete"/>
        <Separator/>
        <MenuItem Header="Passwords and _keys (KeePassXC)..." Click="OnKeePassXc"/>
        <MenuItem Header="S_ync between PCs (git)..." Click="OnSyncSettings"/>
        <Separator/>
        <MenuItem x:Name="HideMenu" Header="_Hide addresses" IsCheckable="False" Click="OnHideAddresses" InputGestureText="Ctrl+Shift+H"
                  ToolTip="Show every IP address, host and user name as dots, for demos and recordings"/>
        <MenuItem x:Name="DetailsMenu" Header="Show address _details in the list" IsCheckable="True" Click="OnAddressDetails"
                  ToolTip="Off: the list shows names only, without user@host:port or a host row's address"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="OnExit"/>
      </MenuItem>
      <MenuItem Header="_Terminal">
        <MenuItem x:Name="FindMenu" Header="_Find in scrollback" Click="OnFind" InputGestureText="Ctrl+Shift+F"/>
        <MenuItem x:Name="ClearMenu" Header="C_lear screen" Click="OnClear"/>
        <MenuItem x:Name="ConnToggleMenu" Header="_Disconnect tab" Click="OnToggleConnection"/>
        <MenuItem x:Name="CloseTabMenu" Header="Close ta_b" Click="OnCloseTab"/>
        <Separator/>
        <MenuItem Header="_Next tab" Click="OnNextTab" InputGestureText="Ctrl+Tab"/>
        <MenuItem Header="P_revious tab" Click="OnPreviousTab" InputGestureText="Ctrl+Shift+Tab"/>
        <MenuItem x:Name="PopOutMenu" Header="_Pop out tab" Click="OnPopOut"/>
        <MenuItem Header="F_ull screen" Click="OnFullScreen" InputGestureText="F11"/>
        <Separator/>
        <MenuItem x:Name="AgentMenu" Header="_Agent on this tab" Click="OnToggleAgent" InputGestureText="Ctrl+Shift+A"/>
        <MenuItem Header="Agent _endpoints and skills..." Click="OnAgentSettings"/>
      </MenuItem>
      <!-- Filled when opened: what is offered depends on the active tab's protocol. -->
      <MenuItem x:Name="FilesMenu" Header="_Files" SubmenuOpened="OnFilesMenuOpened">
        <MenuItem Header="(no tab)" IsEnabled="False"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Getting started" Click="OnGettingStarted"/>
        <MenuItem Header="_User manual" Click="OnManual"/>
        <MenuItem Header="_Report a problem" Click="OnReportProblem"/>
        <Separator/>
        <MenuItem Header="_Open log folder" Click="OnOpenLogs"/>
        <MenuItem Header="_About" Click="OnAbout"/>
      </MenuItem>
    </Menu>

    <!-- A WrapPanel, not a ToolBar: WPF's ToolBar pushes items it thinks do not fit into an
         overflow chevron and clips their labels ("Clos", "Clea"). This wraps to a second row
         instead, so every command stays readable at any window width. -->
    <Border x:Name="ToolStrip" DockPanel.Dock="Top" Background="#141922" BorderBrush="#0F131A" BorderThickness="0,0,0,1" Padding="4,3">
      <WrapPanel Orientation="Horizontal">
        <WrapPanel.Resources>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DFE4EE"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="1,1"/>
            <Setter Property="MinWidth" Value="64"/>
          </Style>
          <!-- A toolbar switch: flat like the buttons, lit blue while on. -->
          <Style TargetType="ToggleButton">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Box" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                          Padding="{TemplateBinding Padding}" CornerRadius="2">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Box" Property="BorderBrush" Value="#3A4459"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Box" Property="Background" Value="#3D5A80"/>
                      <Setter TargetName="Box" Property="BorderBrush" Value="#61AFEF"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Fill" Value="#3A4459"/>
          </Style>
        </WrapPanel.Resources>

        <Button Click="OnNewSession" ToolTip="New shortcut (Ctrl+Shift+T)">New</Button>
        <Button x:Name="OpenButton" Click="OnEdit" ToolTip="Open the selected shortcut's properties">Open</Button>
        <Rectangle/>
        <Button x:Name="ConnectButton" Click="OnConnect" ToolTip="Connect the selected shortcut in a new tab">Connect</Button>
        <Button x:Name="ConnToggle" Click="OnToggleConnection"
                ToolTip="Disconnect the active tab, leaving it open">Disconnect</Button>
        <Button x:Name="CloseButton" Click="OnCloseTab" ToolTip="Disconnect and close the active tab">Close</Button>
        <Rectangle/>
        <Button Click="OnShellMenu" ToolTip="A local shell in a new tab, without saving a shortcut: PowerShell or Command Prompt, as you or as administrator. Administrator relaunches BaudHoundTerm through UAC when it is not already elevated, and needs BaudHoundTerm installed in a folder only administrators can change.">Shell ▾</Button>
        <Rectangle/>
        <Button x:Name="FilesButton" Click="OnFilesButton" ToolTip="Move files to and from the active tab's device or server: SFTP over SSH, typed text files for any terminal">Files ▾</Button>
        <Button x:Name="FindButton" Click="OnFind" ToolTip="Find in scrollback (Ctrl+Shift+F)">Find</Button>
        <Button x:Name="ClearButton" Click="OnClear" ToolTip="Clear the screen">Clear</Button>
        <Rectangle/>
        <Button x:Name="PopOutButton" Click="OnPopOut" ToolTip="Move the active tab into its own window, still connected. Close that window to put it back.">Pop out</Button>
        <Button Click="OnFullScreen" ToolTip="Full screen: only the tabs, nothing else (F11 again to leave). Ctrl+Tab and Ctrl+PgUp/PgDn switch tabs.">Full screen</Button>
        <Rectangle/>
        <Button Click="OnBaudHound" ToolTip="Find BaudHound wireless serial consoles on this PC's networks and open one">BaudHound</Button>
        <Rectangle/>
        <Button x:Name="SyncButton" Click="OnSyncSettings" ToolTip="Share shortcuts between PCs through a private git repository">Sync</Button>
        <Rectangle/>
        <ToggleButton x:Name="HideToggle" Click="OnHideAddresses" Foreground="#DFE4EE" Padding="10,4" Margin="1,1" MinWidth="64"
                      AutomationProperties.Name="Hide addresses"
                      ToolTip="Hide addresses (Ctrl+Shift+H): every IP, host and user name BaudHoundTerm shows becomes dots, for demos and recordings. What a remote screen or shell prompt shows is not covered.">Hide addresses</ToggleButton>
      </WrapPanel>
    </Border>

    <!-- Quick connect: no saved session, just somewhere to go. -->
    <Border x:Name="QuickBar" DockPanel.Dock="Top" Background="#141922" BorderBrush="#0F131A" BorderThickness="0,0,0,1" Padding="5,4">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Left" Text="Quick connect" Foreground="#8B94A7"
                   VerticalAlignment="Center" Margin="4,0,8,0"/>
        <ComboBox x:Name="QuickProtocol" DockPanel.Dock="Left" Width="110" SelectedIndex="0"
                  AutomationProperties.Name="Quick connect protocol"
                  VerticalAlignment="Center" ToolTip="Protocol"
                  SelectionChanged="OnQuickProtocolChanged">
          <ComboBoxItem Content="SSH" Tag="Ssh"/>
          <ComboBoxItem Content="Serial" Tag="Serial"/>
          <ComboBoxItem Content="Local shell" Tag="LocalShell"/>
          <ComboBoxItem Content="Telnet" Tag="Telnet"/>
          <ComboBoxItem Content="VNC" Tag="Vnc"/>
          <ComboBoxItem Content="RDP" Tag="Rdp"/>
        </ComboBox>
        <Button DockPanel.Dock="Right" Content="Connect" Width="90" Margin="8,0,2,0"
                Click="OnQuickConnect"/>

        <!-- Serial asks for a port and a speed rather than a syntax to memorise. -->
        <StackPanel x:Name="QuickSerialPanel" DockPanel.Dock="Left" Orientation="Horizontal"
                    Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,0,0">
          <TextBlock Text="Port" Foreground="#8B94A7" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox x:Name="QuickSerialPort" Width="110" IsEditable="True" KeyDown="OnQuickAddressKey"
                    DropDownOpened="OnSerialPortsDropDown"
                    ToolTip="COM port. The list refreshes each time it is opened."/>
          <TextBlock Text="Baud" Foreground="#8B94A7" VerticalAlignment="Center" Margin="12,0,6,0"/>
          <ComboBox x:Name="QuickBaud" Width="90" IsEditable="True" Text="115200" KeyDown="OnQuickAddressKey"/>
          <TextBlock Text="Framing" Foreground="#8B94A7" VerticalAlignment="Center" Margin="12,0,6,0"/>
          <ComboBox x:Name="QuickFraming" Width="80" SelectedIndex="0"
                    ToolTip="Data bits, parity, stop bits">
            <ComboBoxItem Content="8-N-1"/>
            <ComboBoxItem Content="7-E-1"/>
            <ComboBoxItem Content="7-O-1"/>
            <ComboBoxItem Content="8-N-2"/>
          </ComboBox>
        </StackPanel>

        <TextBox x:Name="QuickAddress" Margin="8,0,0,0" Padding="4,3" VerticalAlignment="Center"
                 AutomationProperties.Name="Quick connect address"
                 KeyDown="OnQuickAddressKey"
                 ToolTip="SSH and RDP: host, host:port or user@host:port (the user name is asked when not given). Telnet: host or host:port. VNC: host, host:port or host:1. Local shell: a command line. Serial has its own fields."/>
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ListColumn" Width="260" MinWidth="180"/>
        <ColumnDefinition x:Name="SplitterColumn" Width="4"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <DockPanel x:Name="ListPanel" Grid.Column="0" Background="#141922">
        <!-- Local tab order: the filter first, then the two buttons beside it, though they come
             first in the markup so they can dock right. -->
        <DockPanel DockPanel.Dock="Top" Margin="6" KeyboardNavigation.TabNavigation="Local">
          <Button DockPanel.Dock="Right" Content="+" Width="26" Margin="6,0,0,0" TabIndex="2"
                  AutomationProperties.Name="New shortcut"
                  ToolTip="New shortcut" Click="OnNewSession"/>
          <ToggleButton x:Name="GroupToggle" DockPanel.Dock="Right" Content="🖥" Width="26" Margin="6,0,0,0"
                        TabIndex="1" AutomationProperties.Name="Group shortcuts by host"
                        FocusVisualStyle="{StaticResource QdFocusVisual}"
                        Click="OnGroupToggle"
                        ToolTip="Each host gets a row with its shortcuts under it, even just one. Off: a flat list. Remembered.">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Box" Background="#2A3245" BorderBrush="#3A4459" BorderThickness="1" CornerRadius="2">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Box" Property="Background" Value="#3D5A80"/>
                    <Setter TargetName="Box" Property="BorderBrush" Value="#61AFEF"/>
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Box" Property="BorderBrush" Value="#8B94A7"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ToggleButton.Template>
          </ToggleButton>
          <TextBox x:Name="FilterBox" Padding="3" TextChanged="OnFilterChanged" TabIndex="0"
                   AutomationProperties.Name="Filter shortcuts"
                   ToolTip="Filter by name, host or tag. Protocol words narrow it: &quot;vnc atlas&quot;, &quot;ssh&quot;, &quot;serial&quot;."/>
        </DockPanel>

        <TreeView x:Name="SessionTree" Background="#141922" Foreground="#DFE4EE"
                  AutomationProperties.Name="Shortcuts" FocusVisualStyle="{StaticResource QdFocusVisual}"
                  BorderThickness="0" MouseDoubleClick="OnTreeActivated"
                  SelectedItemChanged="OnTreeSelectionChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  PreviewMouseRightButtonDown="OnTreeRightClick">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <Setter Property="IsExpanded" Value="True"/>
              <Setter Property="FocusVisualStyle" Value="{StaticResource QdFocusVisual}"/>
              <!-- Without an explicit Foreground the item falls back to the system colour,
                   which is black: invisible on this background. The Style.Resources override
                   the selection brushes for the same reason - the default selected text is
                   black on pale blue. -->
              <Setter Property="Foreground" Value="#DFE4EE"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Padding" Value="2,1"/>
              <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2F3B52"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#232A38"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#DFE4EE"/>
              </Style.Resources>
            </Style>
          </TreeView.ItemContainerStyle>

          <!-- The right-click menu is built per click in OnTreeRightClick, from what was clicked. -->
        </TreeView>
      </DockPanel>

      <GridSplitter x:Name="ListSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#0F131A"
                    AutomationProperties.Name="Resize the shortcut list"
                    FocusVisualStyle="{StaticResource QdFocusVisual}"/>

      <!-- The TabControl's own Background does not paint the content panel, which left a
           white slab before the first tab existed. The Border behind it does. -->
      <Border Grid.Column="2" Background="#0F131A">
        <Grid>
          <!-- Shown until the first tab opens. -->
          <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextAlignment="Center" Foreground="#8B94A7" LineHeight="22">
            Double-click a shortcut, or type an address in Quick connect.<LineBreak/>
            New shortcut: Ctrl+Shift+T
          </TextBlock>
          <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0"
                      SelectionChanged="OnTabSelectionChanged"/>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
