<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 (Windows 10 2004): Windows OCR for the built-in ocr_read helper. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms only to host the Remote Desktop ActiveX control (RdpView). -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>BaudHoundTerm</AssemblyName>
    <Version>0.8.0</Version>
    <!-- The mah7 eagle: exe, taskbar and title bar. -->
    <ApplicationIcon>baudhoundterm.ico</ApplicationIcon>
    <RootNamespace>Quarterdeck.App</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Native DLLs (WebView2Loader, libsodium, SQL Server's SNI...) ship beside the exe, not
         inside it: self-extraction unpacked them under %TEMP%, a folder anything running as the
         user can change, and an administrator copy then loaded them from there. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    Native libraries go in a "dll" folder beside the exe instead of loose around it, so an
    install reads as the program and its three folders. Windows does not look there on its own:
    NativeLibraries.cs adds it to the search path before Main. WebView2Loader keeps its second
    copy under runtimes\win-x64\native, which is where the WebView2 loader looks by itself.
  -->
  <Target Name="NativeLibrariesIntoDllFolder" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Condition="'%(ResolvedFileToPublish.AssetType)' == 'native'"
                             RelativePath="dll\%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)" />
    </ItemGroup>
  </Target>

  <!-- Keep WinForms and GDI+ names out of every file: they clash with WPF's (Button, Color, Brush...). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="baudhoundterm.ico" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!-- RTSP camera tabs. LibVLC and LibVLCSharp are LGPL-2.1-or-later, used as separate DLLs. -->
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <!-- Only what a camera viewer needs from VLC's 113 MB of plugins: RTSP (live555), the H.264 /
       H.265 / AAC / G.711 decoders, video and audio output, colour conversion and PNG for
       snapshots. No Lua, no services discovery, no web interface: nothing that can reach out
       on its own. -->
  <ItemGroup>
    <VlcWindowsX64IncludeFiles Include="libvlc.dll;libvlccore.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\access\liblive555_plugin.dll;plugins\access\librtp_plugin.dll;plugins\access\libtcp_plugin.dll;plugins\access\libudp_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\codec\libavcodec_plugin.dll;plugins\codec\libd3d11va_plugin.dll;plugins\codec\libdxva2_plugin.dll;plugins\codec\libg711_plugin.dll;plugins\codec\libpng_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\packetizer\%2A;plugins\demux\libes_plugin.dll;plugins\demux\libts_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\video_output\libdirect3d11_plugin.dll;plugins\video_output\libdirect3d9_plugin.dll;plugins\video_output\libwingdi_plugin.dll;plugins\video_output\libvmem_plugin.dll;plugins\video_output\libdrawable_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\video_chroma\%2A;plugins\d3d11\%2A;plugins\d3d9\%2A;plugins\video_filter\libdeinterlace_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\audio_output\%2A;plugins\audio_filter\%2A;plugins\audio_mixer\%2A" />
  </ItemGroup>

  <!-- VLC loads its plugins from a folder at run time, so libvlc must sit beside the exe as real
       files (like Assets), not inside the single-file bundle. -->
  <Target Name="KeepLibVlcBesideExe" AfterTargets="CollectVlcFilesToCopyWindows">
    <ItemGroup>
      <Content Condition="$([System.String]::Copy('%(Content.Link)').StartsWith('libvlc'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </Content>
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <!-- The app ships for x64 only. -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quarterdeck.Core\Quarterdeck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The terminal surface is loaded from disk at runtime through a WebView2 virtual host,
         so these must sit beside the executable rather than inside it. -->
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
